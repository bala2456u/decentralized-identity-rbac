# Copy this file to `.env` and fill it in. `.env` is git-ignored.

# Deployer wallet private key. Use a throwaway wallet funded from a faucet,
# never a wallet that holds real funds.
PRIVATE_KEY=

# RPC endpoints — free tier from https://alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# Block-explorer API keys, only needed for `hardhat verify` (optional)
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
